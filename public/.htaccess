<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # A API só libera a origem HTTPS. Em HTTP o navegador bloqueia a remessa.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # index.html do build Vue
  RewriteRule ^index\.html$ - [L]

  # Pastas/arquivos reais (ex.: Upload/ legado) — não reescrever para a SPA
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Vue Router — history mode
  RewriteRule . /index.html [L]
</IfModule>
